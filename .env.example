# ╔════════════════════════════════════════════════════════════╗
# ║          LearnPath AI — Environment Variables             ║
# ╚════════════════════════════════════════════════════════════╝
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── Server ──────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Database (PostgreSQL 16) ────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learnpath_ai?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=learnpath_ai
POSTGRES_PORT=5432

# ── Authentication ──────────────────────────────────
# REQUIRED: Generate a strong random secret (min 32 chars)
# Example: openssl rand -base64 48
JWT_SECRET=production_secret_key_learnpath_ai_2026_enterprise_min32
JWT_EXPIRES_IN=7d

# ── Enterprise Admin Security Code ──────────────────
# Master 2FA access code for the /back admin portal
ADMIN_SECURITY_CODE=HCL-ADMIN-2026

# ── AI Mentor: Primary LLM Provider (Groq / FreeLLMAPI / OpenAI) ───
# For Groq (14,400 free requests/day):
# Get free key at https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Alternatively, set GROQ_API_KEY directly:
# GROQ_API_KEY=gsk_your_groq_api_key_here

# ── AI Mentor: Direct Google Gemini (Optional Fallback) ───
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── Security & CORS ─────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5000,http://localhost:5173,http://127.0.0.1:5173
